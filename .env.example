# Local mode is durable SQLite; NEVER use it on Vercel.
STORAGE_DRIVER=local
CONTROL_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production: STORAGE_DRIVER=supabase. Apply database/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional local DB path (default .data/graffitifest.sqlite)
# LOCAL_DB_PATH=
