# Rehearsal: durable SQLite, no cloud account required.
STORAGE_DRIVER=local
CONTROL_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel automatically uses Blob. Connect a PRIVATE Blob store in project Storage.
# Storage credentials are supplied by Vercel, not checked into this file.
# Optional for local testing with a private cloud store:
# STORAGE_DRIVER=blob
# BLOB_READ_WRITE_TOKEN=
# BLOB_NAMESPACE=development
# Optional local DB path (default .data/graffitifest.sqlite, preserved for compatibility)
# LOCAL_DB_PATH=
